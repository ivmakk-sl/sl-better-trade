<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props at the mod root.
       This file names the plugin and adds the assemblies that only this mod uses. -->
  <PropertyGroup>
    <AssemblyName>BetterTrade</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The page script is built from src/Web/ by Vite (package.json at the mod root) into one file,
       which the plugin embeds under one name. The build runs only when a page source changed. -->
  <PropertyGroup>
    <ModRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</ModRoot>
    <PageBundle>$(ModRoot)\obj\page\page.js</PageBundle>
  </PropertyGroup>

  <ItemGroup>
    <PageSource Include="Web\**\*.ts;Web\**\*.js;Web\**\*.css" />
    <PageSource Include="Shared\**\web\**" />
    <PageSource Include="$(ModRoot)\package.json;$(ModRoot)\package-lock.json;$(ModRoot)\vite.config.ts" />
    <EmbeddedResource Include="$(PageBundle)" LogicalName="BetterTrade.page.js" />
    <!-- The head bar icon of the trading tag: the sprite data of the coin in the icons library copy. -->
    <EmbeddedResource Include="Shared\icons\sprite\trade.alpha" LogicalName="BetterTrade.trade-tag.alpha" />
    <!-- The i18n files of the mod texts, read by the i18n library copy. -->
    <EmbeddedResource Include="i18n\*.json" LogicalName="BetterTrade.i18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="BuildPage" BeforeTargets="BeforeBuild" Inputs="@(PageSource)" Outputs="$(PageBundle)">
    <Error Condition="!Exists('$(ModRoot)\node_modules')" Text="BetterTrade: the npm packages are missing. Run npm ci in $(ModRoot) first." />
    <Exec Command="npm run build" WorkingDirectory="$(ModRoot)" />
  </Target>

  <!-- The trade window is a page of the Vuplex web view: Vuplex for WebUILayer and the page messages,
       and R3 for the ReactiveProperty state of State_Web_TradeUI. -->
  <ItemGroup>
    <_Ref Include="$(BepInExInterop)\Vuplex.WebView.dll" />
    <_Ref Include="$(BepInExInterop)\R3.dll" />
    <Reference Include="@(_Ref)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
